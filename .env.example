# Copy this file to .env and fill in ONE provider. Never commit .env.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Or a private Azure OpenAI deployment (choose an EU region / EU data zone):
# LLM_PROVIDER=azure_openai
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=

# Optional: protect the hosted web app
# APP_PASSWORD=
